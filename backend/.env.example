# ─── Base de datos ───────────────────────────────────────────────────────
DATABASE_URL=postgresql+pg8000://usuario:password@host:5432/basedatos

# ─── Seguridad ───────────────────────────────────────────────────────────
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=150
SESSION_EXPIRE_MINUTES=120

# ─── Motor de evaluación ─────────────────────────────────────────────────
DEFAULT_UMBRAL_CONFIANZA=0.85
MARGEN_MINIMO_CIERRE=0.25
MIN_NODOS_REQUERIDOS=15
MIN_PALABRAS_RESPUESTA=10

# development | production
ENV=development

# ─── Correo saliente ─────────────────────────────────────────────────────
EMAIL_HABILITADO=true
# Host del servidor SMTP (preguntar al área de sistemas de la universidad)
SMTP_HOST=
# 587 con starttls | 465 con ssl | 25 con ninguno
SMTP_PORT=587
SMTP_MODO=starttls
# Dejar SMTP_USER vacío si el relay autoriza por IP y no pide autenticación
SMTP_USER=
SMTP_PASSWORD=
# Dirección institucional que verá el destinatario
SMTP_FROM=
SMTP_FROM_NOMBRE=Sistema de Evaluacion de Perfiles Laborales
SMTP_TIMEOUT=20
